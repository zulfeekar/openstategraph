{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  // `src/app/devServerWatch.ts` holds the dev server's watch-ignore list, so
  // the rule has one definition that both this config and a test can read.
  "include": ["vite.config.ts", "vitest.generate.config.ts", "src/app/devServerWatch.ts"]
}

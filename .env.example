# Copy to .env and fill in what you use. Nothing here is required to run the
# editor — the canvas preview works with zero credentials on Mock/Ollama.
#
# **This file lists variable NAMES and never values.** `.env` is gitignored;
# this file is committed, so a value here is a leaked credential. The provider
# block below is generated from the provider registry
# (openstategraph/providers.py) so a newly registered vendor documents itself —
# `tests/test_config_file.py::TestEnvExampleParity` fails if the two drift.
#
# Non-secret model/provider defaults belong in `openstategraph.yaml` instead
# (openstategraph/config_file.py). Precedence, lowest to highest:
#   config file < environment < workflow settings.model < node's model < caller

# >>> generated from the provider registry — do not edit by hand
#
# Regenerate: python3 -m openstategraph.cli env-example

# --- Anthropic ---
# Required for anthropic: without it this provider is skipped.
ANTHROPIC_API_KEY=
# Overrides the default model (claude-haiku-4-5) for anthropic.
OPENSTATEGRAPH_ANTHROPIC_MODEL=

# --- OpenAI ---
# Required for openai: without it this provider is skipped.
OPENAI_API_KEY=
# Overrides the default model (gpt-4.1-mini) for openai.
OPENSTATEGRAPH_OPENAI_MODEL=

# --- Ollama ---
# Required for ollama: set one of OLLAMA_API_KEY or OLLAMA_HOST — with none of them this provider is skipped.
OLLAMA_API_KEY=
OLLAMA_HOST=
# Optional for ollama; accepted from a run request.
OLLAMA_ENDPOINT=
# Overrides the default model (gpt-oss:120b-cloud) for ollama.
OPENSTATEGRAPH_OLLAMA_MODEL=

# <<< end generated

# --- Editor and runtime ---

# Ollama is cloud-only in this project — see CLAUDE.md's "Ollama means
# Ollama cloud, never a local model" standing instruction.

# Backend log verbosity, passed straight to logging.basicConfig.
# One of DEBUG, INFO, WARNING, ERROR. Defaults to INFO if unset.
# Read by backend/openstategraph/api/main.py.
OPENSTATEGRAPH_LOG_LEVEL=

# Points at a config file outside the project root.
# Read by backend/openstategraph/config_file.py.
OPENSTATEGRAPH_CONFIG=

# Set to 1 to ignore every installed plugin (tools, knowledge builders,
# providers), so a reproducible run does not depend on a colleague's venv.
OPENSTATEGRAPH_DISABLE_PLUGINS=

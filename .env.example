# Copy to .env and fill in what you use. Nothing here is required to run the
# editor — the canvas preview works with zero credentials on Mock/Ollama.
# These are read by the backend (backend/openstategraph/api/main.py, resolve_model).

# Overrides the Ollama cloud default when set.
ANTHROPIC_API_KEY=

# Overrides the Ollama cloud default when set (checked after Anthropic).
OPENAI_API_KEY=

# Ollama is cloud-only in this project — see CLAUDE.md's "Ollama means
# Ollama cloud, never a local model" standing instruction. Defaults to
# "ollama:gpt-oss:120b-cloud" if unset.
OPENSTATEGRAPH_OLLAMA_MODEL=

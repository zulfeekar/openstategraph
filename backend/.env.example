
# --- Deployment ---------------------------------------------------------
# Shared bearer token for the HTTP API and the MCP layer. Unset means NO
# auth: anyone who reaches the port can run workflows, read every workflow
# file and spend your model budget. See docs/deploying.md.
OPENSTATEGRAPH_API_TOKEN=

# Where durable state (approval checkpoints, the serve lock) is written.
# Defaults to the platform state dir when installed, or the checkout's
# .openstategraph/ in a repo. Never inside someone else's workflows folder.
OPENSTATEGRAPH_STATE_DIR=

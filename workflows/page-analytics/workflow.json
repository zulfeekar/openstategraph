      {
        "id": "in-style",
        "type": "input.markdown",
        "title": "Reporting House Style",
        "data": {
          "filename": "reporting-house-style.md",
          "instruction": "House style for analytics reporting:\n- Lead with the headline number, then the comparison window.\n- Views, revenue, falloff and trends each get their own section.\n- Falloff = exit rate per funnel step (pages.funnel_step 1..3); always name the worst step.\n- Cite tables for every figure. Round money to whole USD.\n- Close with exactly three recommended actions."
        },
        "position": {
          "x": 40,
          "y": 80
        }
      },
      {
        "id": "router1",
        "type": "route.classifier",
        "data": {
          "branches": [
            {
              "id": "b-report",
              "name": "full_report"
            },
            {
              "id": "b-metric",
              "name": "quick_metric"
            },
            {
              "id": "b-deep",
              "name": "database_deep_dive"
            },
            {
              "id": "b-context",
              "name": "industry_context"
            },
            {
              "id": "b-chat",
              "name": "conversation"
            }
          ],
          "fallback": "conversation",
          "rules": "full_report: asks for the complete page-analytics report (views, revenue, falloff, trends) or to send/email the report. quick_metric: asks for one specific NEW number or comparison from our data. database_deep_dive: open-ended exploration of the analytics database. industry_context: benchmarks or facts about the wider world/industry, not our data. conversation: greetings, follow-ups about a previous answer (how did you get this, explain, why), questions about what this workflow can do, and anything that fits no other branch."
        },
        "position": {
          "x": 360,
          "y": 380
        }
      },
      {
        "id": "lead1",
        "type": "orchestrate.supervisor",
        "title": "Analytics Lead",
        "data": {
          "maxSubtasks": 4,
          "instruction": "Produce the weekly page-analytics report. Split into per-specialist subtasks: traffic (views, bounce, falloff by funnel step), revenue (totals, by product and page, refunds), trends (week-over-week movement, experiments, referrer quality). Each subtask names the tables to use."
        },
        "position": {
          "x": 700,
          "y": 380
        }
      },
